{
  "coordinatorId": "lead",
  "federation": { "enabled": false },
  "workspaceRoot": ".local/workspaces",
  "defaults": {
    "capabilities": []
  },
  "templates": {
    "coordinator": {
      "name": "团队助手",
      "manager": true,
      "runtime": "claude",
      "model": "glm-5.3",
      "capabilities": [
        "协调",
        "验收"
      ],
      "instructions": "你是本团队的协调者。按共享网络规范组织成员、验收工作并向用户交付。"
    },
    "researcher": {
      "name": "资料同事",
      "runtime": "claude",
      "model": "glm-5.3-flash",
      "capabilities": [
        "资料",
        "文档"
      ],
      "instructions": "核对资料并向本轮派单人交付。"
    },
    "engineer": {
      "name": "工程同事",
      "runtime": "dsh",
      "model": "deepseek-v4.1-flash",
      "capabilities": [
        "工程",
        "验证"
      ],
      "instructions": "实际执行、核验并向本轮派单人交付。"
    }
  },
  "agents": {
    "claude-worker": {
      "template": "researcher"
    },
    "dsh-worker": {
      "template": "engineer"
    },
    "lead": {
      "template": "coordinator"
    }
  },
  "models": {
    "glm-5.3": {
      "name": "glm-5.3"
    },
    "glm-5.3-flash": {
      "name": "glm-5.3-flash"
    },
    "deepseek-v4.1-flash": {
      "name": "deepseek-v4.1-flash"
    }
  }
}
